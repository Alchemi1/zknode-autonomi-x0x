# Architecture
TARGETARCH=arm64

# Images
IMAGE_MIXNET=zeros/mixnet-node:arm64
IMAGE_MIXNET_PROXY=zeros/mixnet-proxy:arm64
IMAGE_X0X=zknode-x0xd:latest
IMAGE_FAE=zknode-fae:latest
IMAGE_WALLETSHIELD=zeros/walletshield:arm64
IMAGE_STORAGE_PROVED=zeros/storage-proved-rs:arm64
IMAGE_ANTD=zeros/antd:arm64
IMAGE_RETICULUM=zeros/reticulum:arm64
IMAGE_LLM_WIKI=zeros/llm-wiki:arm64
IMAGE_DASHBOARD=zknode-dashboard:latest

# Memory Limits
MIXNET_MEM_LIMIT=256m
PROXY_MEM_LIMIT=128m
X0X_MEM_LIMIT=256m
FAE_MEM_LIMIT=512m
LLM_WIKI_MEM_LIMIT=1g

# Ports
DASHBOARD_PORT=8080
X0X_API_PORT=11700
FAE_API_PORT=11780

# Data Directories
X0X_DATA_DIR=./data/x0x
FAE_DATA_DIR=./data/fae
AUTONOMI_CHUNK_DB=./data/chunks
AUTONOMI_LOGS_DIR=./data/logs
ANT_CLI_PATH=/usr/local/bin/ant
ANT_DATA_DIR=./data/ant
WIKI_DATA_DIR=./data/wikis

# Network
AUTONOMI_EVM_NETWORK=arbitrum-sepolia

# X0X
X0X_VERSION=0.34.3
