# FAE — Personal AI Companion
# Note: FAE binary is distributed by Saorsa Labs.
# See: https://fae.saorsalabs.com (coming soon)
# This Dockerfile is a scaffold that will be updated when the binary is released.

ARG TARGETARCH=arm64

FROM alpine:3.20 AS base

RUN apk add --no-cache ca-certificates libssl3 curl jq sqlite

# FAE binary — replace with actual download URL when available
# RUN curl -sfL https://fae.saorsalabs.com/download/fae-${TARGETARCH}.tar.gz | tar xz -C /usr/local/bin/

COPY config/fae/config.toml /etc/fae/config.toml

RUN mkdir -p /var/lib/fae /var/lib/fae/memory /var/lib/fae/skills

VOLUME ["/var/lib/fae"]

EXPOSE 11780 11790

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -sf http://127.0.0.1:11780/health || exit 1

ENTRYPOINT ["fae"]
CMD ["--config", "/etc/fae/config.toml", "--data-dir", "/var/lib/fae"]
